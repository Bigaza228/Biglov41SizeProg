<Page x:Class="Biglov41SizeProg.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Biglov41SizeProg"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>
        <WrapPanel Orientation="Horizontal" Grid.Row="0" Margin="5">
            <StackPanel Orientation="Vertical" Margin="5">
                <TextBlock Style="{StaticResource CustomTextStyle}" Text="Дата формирования заказа"/>
                <TextBlock Style="{StaticResource CustomTextStyle}" Text="Дата доставки заказа"/>
                <TextBlock Style="{StaticResource CustomTextStyle}" Text="ФИО клиента"/>
                <TextBlock Style="{StaticResource CustomTextStyle}" Text="Номер заказа"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="5">
                <DatePicker Width="500" FontSize="20" Name="StartDatePicker" HorizontalAlignment="Right"/>
                <DatePicker Width="500" FontSize="20" Name="EndDatePicker"/>
                <TextBlock Style="{StaticResource CustomTextStyle}" Name="TBNameClient"/>
                <TextBlock Style="{StaticResource CustomTextStyle}" Name="TBOrderNumber"/>
            </StackPanel>
        </WrapPanel>
        <ListView Name="ProductListView" Grid.Row="1" HorizontalContentAlignment="Stretch" Margin="5">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Stretch="Uniform">
                                <Image.Source>
                                    <Binding Path="ProductPhotoPathFull"/>
                                </Image.Source>
                            </Image>
                            <WrapPanel Grid.Column="1" Margin="5" Orientation="Vertical">
                                <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding ProductName}"/>
                                <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding ProductDescription}"/>
                                <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding ProductManufacturer}"/>
                                <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding ProductCost}"/>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <Button Name="BTturnDown" Content="-" Click="BTturnDown_Click" Width="20"/>
                                    <TextBlock Style="{StaticResource CustomTextStyle}" Name="TBcount" Text="{Binding CountForOrder}"/>
                                    <Button Name="BTadd" Content="+" Click="BTadd_Click" Width="20"/>
                                </StackPanel>
                            </WrapPanel>                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Margin="5" Orientation="Vertical">
            <ComboBox Name="CBPickUpPoint" Grid.Row="2" Margin="5" HorizontalContentAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding PickUpPointIndex}"/>
                            <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding PickUpPointCity}"/>
                            <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding PickUpPointStreet}"/>
                            <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding PickUpPointhouse}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Name="BTSave" Content="Сохранить" Click="BTSave_Click"/>
        </StackPanel>        
    </Grid>
</Page>
