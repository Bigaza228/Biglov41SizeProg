<Page x:Class="Biglov41SizeProg.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Biglov41SizeProg"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
            <StackPanel Orientation="Vertical" Margin="5">
                <TextBlock Style="{StaticResource CustomTextStyle}" Name="TBlogin"/>
                <TextBlock Style="{StaticResource CustomTextStyle}" Name="TBrole"/>
            </StackPanel>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
            <TextBlock Style="{StaticResource CustomTextStyle}" Name="TBcount" VerticalAlignment="Center" Margin="5,0,15,0"/>
            <StackPanel Orientation="Vertical" Margin="5">
                <TextBlock Style="{StaticResource CustomTextStyle}" Text="поиск по наименованию"/>
                <TextBox Name="TBsearchName" TextChanged="TBsearchName_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="5">
                <RadioButton Name="RButtonUp" Content="по возрастанию стоимости" FontSize="20" GroupName="Sort" Checked="RButtonUp_Checked"/>
                <RadioButton Name="RButtonDown" Content="по убыванию стоимости" FontSize="20" GroupName="Sort" Checked="RButtonDown_Checked"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="5">
                <TextBlock Style="{StaticResource CustomTextStyle}" Text="фильтрация по скидке"/>
                <ComboBox Name="CBoxSort" SelectionChanged="CBoxSort_SelectionChanged">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>0-9,99%</TextBlock>
                    <TextBlock>10-14,99%</TextBlock>
                    <TextBlock>15% и более</TextBlock>
                </ComboBox>
            </StackPanel>
        </WrapPanel>

        <ListView Name="ProductListView" Margin="5" HorizontalContentAlignment="Stretch" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" Stretch="Uniform">
                                <Image.Source>
                                    <Binding Path="ProductPhotoPathFull"/>
                                </Image.Source>
                            </Image>
                            <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding ProductDescription}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding ProductManufacturer}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding ProductCost, StringFormat='{}{0} руб.'}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left"/>
                            <TextBlock Style="{StaticResource CustomTextStyle}" Text="Скидка" Grid.Column="2" Grid.Row="0"/>
                            <TextBlock Style="{StaticResource CustomTextStyle}" Text="{Binding ProductDiscountAmountInt, StringFormat='{}{0} %'}" Grid.Column="2" Grid.Row="1" Grid.RowSpan="4" FontSize="35"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
