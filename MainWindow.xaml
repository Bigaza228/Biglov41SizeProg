<Window x:Class="Biglov41SizeProg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biglov41SizeProg"
        mc:Ignorable="d"
        Icon="res\icon.ico"
        Title="Biglov41Size" Height="650" Width="800" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
        </Grid.RowDefinitions>
        <Image Source="res\logo.png" Grid.Row="0" HorizontalAlignment="Left" Margin="2"></Image>
        <TextBlock Text="ООО «41 размер»" Grid.Row="0" HorizontalAlignment="Center" Margin="5" 
                   FontSize="30" FontFamily="Comic Sans MS" VerticalAlignment="Center"></TextBlock>
        <Button x:Name="BtnBack" Content="Назад" Grid.Row="0" HorizontalAlignment="Right" Margin="15" 
                FontSize="20" FontFamily="Comic Sans MS" Width="150" Height="40" Click="BtnBack_Click" Background="#FFCC6600" Visibility="Collapsed"></Button>
        <Frame x:Name="ProductPg" Grid.Row="1" ContentRendered="ProductPg_ContentRendered"></Frame>
    </Grid>
</Window>
