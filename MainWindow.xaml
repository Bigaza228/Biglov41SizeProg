<Window x:Class="Biglov41SizeProg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biglov41SizeProg"
        mc:Ignorable="d"
        Icon="Res\icon.ico"
        Title="Biglov41Size" Height="700" Width="1000" FontFamily="Comic Sans MS">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
        </Grid.RowDefinitions>
        <Image Source="Res\logo.png" Grid.Row="0" HorizontalAlignment="Left" Margin="2"></Image>
        <TextBlock Style="{StaticResource CustomTextStyle}" Text="ООО «41 размер»" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        <Button Name="BtnBack" Content="Назад" Grid.Row="0" HorizontalAlignment="Right" Visibility="Collapsed" Click="BtnBack_Click"></Button>
        <Frame Name="ProductPg" Grid.Row="2" ContentRendered="ProductPg_ContentRendered_1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
